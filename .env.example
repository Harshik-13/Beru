# Beru — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Application
APP_ENV=development
APP_NAME=beru
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://beru:changeme@localhost:5432/beru

# LLM Provider Configuration
# Supported providers: mock, openrouter, nvidia, opencode_zen
# Model is REQUIRED for real providers (no default)
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# LLM Rate Limiting (per student)
LLM_RATE_LIMIT_MAX_REQUESTS=30
LLM_RATE_LIMIT_WINDOW_SECONDS=60

# Portal Integration Configuration
PORTAL_BASE_URL=https://automation.vnrvjiet.ac.in/
# PORTAL_CREDENTIAL_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Telegram Bot Configuration
# Telegram is the Personal Alpha LIVE interface
# WhatsApp/Baileys remains a replaceable future adapter
# Bot token is secret configuration — NEVER provide a default
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_DROP_PENDING_UPDATES=true